# Base de données
# - Dev local : SQLite (chemin relatif au dossier prisma/)
#   DATABASE_URL="file:./dev.db"
# - Production (Vercel) : Turso (SQLite cloud gratuit). URL type :
#   DATABASE_URL="libsql://ma-base-nom-utilisateur.turso.io"
#   TURSO_AUTH_TOKEN="eyJhbGciOi..."  (jeton généré dans Turso -> Tokens)
DATABASE_URL="file:./dev.db"
TURSO_AUTH_TOKEN=""

# --- Providers IA (fallback automatique, étape 3) ---
# Priorité par défaut : OpenRouter -> Groq -> Google AI (Gemini) -> OpenAI (dernier recours)
# (Dans .env, l'ordre effectif est : Groq -> OpenRouter -> Google AI -> OpenAI.)
# Optionnel : override <NOM>_BASE_URL pour pointer un proxy/mock OpenAI-compatible
# (ex: GROQ_BASE_URL="http://localhost:4310/groq"). Sinon, laisser vide.

# OpenRouter (agrégateur multi-modèles)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/auto"

# Groq (rapide, tier gratuit)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Google AI Studio / Gemini
GOOGLE_AI_API_KEY=""
GOOGLE_AI_MODEL="gemini-2.0-flash"

# OpenAI (tier gratuit - dernier recours)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"