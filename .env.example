# Base de données
# - Dev local : SQLite (chemin relatif au dossier prisma/)
#   DATABASE_URL="file:./dev.db"
# - Production (Vercel) : Turso (SQLite cloud gratuit). URL type :
#   DATABASE_URL="libsql://ma-base-nom-utilisateur.turso.io"
#   TURSO_AUTH_TOKEN="eyJhbGciOi..."  (jeton généré dans Turso -> Tokens)
DATABASE_URL="file:./dev.db"
TURSO_AUTH_TOKEN=""

# --- Fournisseurs IA ---
# Un seul fournisseur est actif par défaut : Google AI (Gemini).
# Noms attendus : <PREFIXE>_API_KEY et <PREFIXE>_MODEL, où PREFIXE est déclaré
# dans PROVIDER_DEFINITIONS (lib/ai.ts). Override possible via <PREFIXE>_BASE_URL
# pour pointer un proxy compatible OpenAI. Sinon, laisser vide.

# Google AI Studio / Gemini
GOOGLE_AI_API_KEY=""
# Modèles valides : GET https://generativelanguage.googleapis.com/v1beta/models
# ex. gemini-3.8-flash | gemini-3.5-flash | gemini-2.5-flash | gemini-flash-latest
# ("gemini-flash-latest" suit toujours le dernier Flash stable, jamais de 404)
GOOGLE_AI_MODEL="gemini-3.8-flash"

# Pour (ré)activer un fournisseur : ajouter une entrée dans PROVIDER_DEFINITIONS
# (lib/ai.ts), puis les variables <PREFIXE>_API_KEY / <PREFIXE>_MODEL. Groq,
# OpenRouter et OpenAI ont été retirés (modèle retiré côté Groq, clé OpenRouter
# invalide, crédits OpenAI épuisés) : le repli automatique reste disponible.

# Auth (obligatoire en production)
NEXTAUTH_SECRET="une-chaine-aleatoire-longue-et-secrete"
NEXTAUTH_URL="https://prompt-forge.vercel.app"

# --- Protection / Limites (optionnel) ---
# Quota de génération par utilisateur sur une fenêtre glissante.
# RATE_LIMIT_MAX = nombre max d'appels / RATE_LIMIT_WINDOW_MS = fenêtre en ms.
# Valeurs par défaut : 30 appels / 1 heure (1 800 000 ms).
# RATE_LIMIT_MAX="30"
# RATE_LIMIT_WINDOW_MS="1800000"

# --- Protection / Limites IP (optionnel) ---
# Limite d'appels par adresse IP (registration + endpoint public /api/shared).
# Valeurs par défaut : 60 appels / 1 minute (60 000 ms).
# IP_RATE_LIMIT_MAX="60"
# IP_RATE_LIMIT_WINDOW_MS="60000"
