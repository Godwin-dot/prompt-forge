# Base de données
# - Dev local : SQLite (chemin relatif au dossier prisma/)
#   DATABASE_URL="file:./dev.db"
# - Production (Vercel) : Turso (SQLite cloud gratuit). URL type :
#   DATABASE_URL="libsql://ma-base-nom-utilisateur.turso.io"
#   TURSO_AUTH_TOKEN="eyJhbGciOi..."  (jeton généré dans Turso -> Tokens)
DATABASE_URL="file:./dev.db"
TURSO_AUTH_TOKEN=""

# --- Providers IA (fallback automatique, étape 3) ---
# Ordre effectif = celui du code dans lib/ai.ts : Groq -> OpenRouter -> Google AI (Gemini) -> OpenAI (dernier recours)
# (Override possible via <NOM>_BASE_URL pour pointer un proxy/mock OpenAI-compatible,
# ex: GROQ_BASE_URL="http://localhost:4310/groq". Sinon, laisser vide.)

# OpenRouter (agrégateur multi-modèles)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/auto"

# Groq (rapide, tier gratuit)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Google AI Studio / Gemini
GOOGLE_AI_API_KEY=""
GOOGLE_AI_MODEL="gemini-2.0-flash"

# OpenAI (tier gratuit - dernier recours)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Auth (obligatoire en production)
NEXTAUTH_SECRET="une-chaine-al�atoire-longue-et-secrete"
NEXTAUTH_URL="https://prompt-forge.vercel.app"

# --- Protection / Limites (optionnel) ---
# Quota de génération par utilisateur sur une fenêtre glissante.
# RATE_LIMIT_MAX = nombre max d'appels / RATE_LIMIT_WINDOW_MS = fenêtre en ms.
# Valeurs par défaut : 30 appels / 1 heure (1 800 000 ms).
# RATE_LIMIT_MAX="30"
# RATE_LIMIT_WINDOW_MS="1800000"
